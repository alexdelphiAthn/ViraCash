    <Target Name="CompilarMarcaViraCash" BeforeTargets="_PasCoreCompile" Inputs="$(MSBuildProjectDirectory)\fondo.rc;$(MSBuildProjectDirectory)\fondo_viracash.png;$(MSBuildProjectDirectory)\fondo_viracash_oscuro.png" Outputs="$(MSBuildProjectDirectory)\fondo.res">
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="&quot;$(BDS)\bin\brcc32.exe&quot; -fofondo.res fondo.rc"/>
    </Target>
    <Target Name="CopiarLicenciaWebView2" AfterTargets="CoreBuild">
        <PropertyGroup>
            <OrigenWebView2>$(MSBuildProjectDirectory)\src\3rdpartyComp\WebView2</OrigenWebView2>
        </PropertyGroup>
        <Copy SourceFiles="$(OrigenWebView2)\Microsoft.WebView2.LICENSE.txt" DestinationFolder="$(DCC_ExeOutput)" SkipUnchangedFiles="true"/>
    </Target>
